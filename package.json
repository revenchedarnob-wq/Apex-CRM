        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@types/compression": "1.7.5",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "@types/papaparse": "^5.5.2",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.7",
        "@vitejs/plugin-react": "6.1.1",
        "autoprefixer": "10.5.5",
        "esbuild": "0.28.2",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.13",
        "typescript": "^7.0.2",
        "vite": "8.2.2"
    }

{
    "name": "react-example",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "tsx scripts/dev.ts",
        "dev:server": "tsx server.ts",
        "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
        "prebuild": "npm run typecheck",
        "start": "node dist/server.cjs --production",
        "clean": "node -e \"const fs=require('fs');['dist','server.js'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}});\"",
        "lint": "tsc --noEmit",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test \"test/*.test.ts\"",
        "test:all": "tsx --test \"test/*.test.ts\"",
        "test:eval": "tsx --test test/queryIntelligence.eval.ts",
        "test:enrichment": "tsx --test test/enrichmentCache.test.ts test/linkedinEvidence.test.ts test/linkedinPostIntent.test.ts",
        "test:lead-search": "tsx --test test/leadSearchHelpers.test.ts",
        "test:prospect-quality": "tsx --test test/prospectQuality.test.ts test/contractShape.test.ts",
        "test:taxonomy": "tsx --test test/contractShape.test.ts",
        "test:distributed-query": "tsx --test test/distributedQueryEnforcement.test.ts",
        "test:semantic-grouping": "tsx --test test/semanticGrouping.test.ts",
        "test:evidence-aware": "tsx --test test/evidenceAwareHardness.test.ts",
        "test:class-scheduler": "tsx --test test/classAwareScheduler.test.ts",
        "test:enhanced-diagnostics": "tsx --test test/enhancedDiagnostics.test.ts",
        "test:optimizations": "tsx --test test/fuzzyQuoteGrounding.test.ts test/safeSlugProbe.test.ts test/companyEntityResolution.test.ts test/resilienceAndCacheHygiene.test.ts",
        "test:critical-fixes": "tsx --test test/llmStructuredArrayCoercion.test.ts test/siteProbeSsrfGuard.test.ts test/sessionStreamHubPruning.test.ts test/kalmanStability.test.ts",
        "test:hard-terms": "tsx --test test/contractShape.test.ts test/distributedQueryEnforcement.test.ts test/semanticGrouping.test.ts test/evidenceAwareHardness.test.ts test/classAwareScheduler.test.ts test/enhancedDiagnostics.test.ts",
        "test:scout": "tsx --test test/scoutPipeline.test.ts",
        "test:brightdata-upgrade": "tsx --test test/brightDataUpgrade.test.ts",
        "test:key-rotation": "tsx --test test/keyRotator.test.ts test/tavilyRotation.test.ts",
        "test:llm": "tsx --test test/llmFallback.test.ts test/llmBudget.test.ts test/atriaProvider.test.ts",
        "test:telemetry": "tsx --test test/telemetry.test.ts",
        "test:glyphs": "tsx --test test/encodingHygiene.test.ts",
        "test:ui": "tsx --test test/uiContracts.test.ts",
        "test:persistence": "tsx --test test/leadPersistence.test.ts",
        "test:dedupe": "tsx --test test/leadDedupe.test.ts test/leadIdentityMigration.test.ts test/leadPersistence.test.ts",
        "test:intent-engine": "tsx --test test/adaptiveDecomposition.test.ts test/intentSignals.test.ts test/intentEnrichment.test.ts test/linkedinPostIntent.test.ts",
        "test:piq-bos": "tsx --test test/progressiveQualification.test.ts",
        "test:lead-engine": "tsx --test test/contractShape.test.ts test/adaptiveDecomposition.test.ts test/intentSignals.test.ts test/intentEnrichment.test.ts test/linkedinPostIntent.test.ts test/leadSearchHelpers.test.ts test/targetFulfillment.test.ts test/targetFulfillmentReplay.test.ts test/signalStore.test.ts test/scoutPipeline.test.ts test/adaptiveScheduler.test.ts test/enrichmentCache.test.ts test/linkedinEvidence.test.ts test/brightDataUpgrade.test.ts test/keyRotator.test.ts test/tavilyRotation.test.ts test/llmFallback.test.ts test/llmBudget.test.ts test/telemetry.test.ts test/encodingHygiene.test.ts test/uiContracts.test.ts test/leadPersistence.test.ts test/leadMutationContracts.test.ts test/sessionPersistenceAndResume.test.ts test/parallelRetrieval.test.ts test/rateLimitMigration.test.ts test/siteProbe.test.ts test/progressiveQualification.test.ts"
    },
    "dependencies": {
        "@brightdata/mcp": "2.11.1",
        "@duckdb/node-api": "1.5.6-r.1",
        "@modelcontextprotocol/sdk": "1.30.0",
        "@radix-ui/react-dialog": "1.1.23",
        "@radix-ui/react-label": "2.1.15",
        "@radix-ui/react-slot": "1.3.3",
        "@radix-ui/react-tabs": "1.1.21",
        "@tanstack/react-table": "^8.21.3",
        "@tanstack/react-virtual": "^3.14.10",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "compression": "1.8.1",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "lucide-react": "1.41.0",
        "motion": "12.43.0",
        "p-queue": "9.3.3",
